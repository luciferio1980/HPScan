<Window x:Class="CanonScanStudio.App.Views.CropPageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recortar página"
        Height="720" Width="980"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1E1E1E">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#D9D9D9" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="110" Margin="0,0,8,0" Click="OnCancel" />
                    <Button Content="Aceptar" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="110" Click="OnAccept" />
                </StackPanel>
                <TextBlock Text="Arrastra el recuadro o sus esquinas. Lo de fuera (transparencia oscura) se recorta; lo de dentro se queda."
                           Foreground="#6B6B6B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
            </DockPanel>
        </Border>
        <Grid x:Name="Stage" Background="#2A2A2A" SizeChanged="OnStageSizeChanged" ClipToBounds="True">
            <Canvas x:Name="Work" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="Photo" Stretch="Fill" />
                <Path x:Name="DimOverlay" Fill="#99000000" IsHitTestVisible="False" />
                <Rectangle x:Name="CropBorder"
                           Stroke="#FFFFFF"
                           StrokeThickness="2"
                           Fill="Transparent"
                           Cursor="SizeAll"
                           MouseLeftButtonDown="OnCropMouseDown"
                           MouseMove="OnCropMouseMove"
                           MouseLeftButtonUp="OnCropMouseUp" />
                <Rectangle x:Name="HandleNw" Width="10" Height="10" Fill="White" Stroke="#1E88E5" StrokeThickness="1" SnapsToDevicePixels="True" Cursor="SizeNWSE" MouseLeftButtonDown="OnHandleDown" Tag="nw" />
                <Rectangle x:Name="HandleNe" Width="10" Height="10" Fill="White" Stroke="#1E88E5" StrokeThickness="1" SnapsToDevicePixels="True" Cursor="SizeNESW" MouseLeftButtonDown="OnHandleDown" Tag="ne" />
                <Rectangle x:Name="HandleSw" Width="10" Height="10" Fill="White" Stroke="#1E88E5" StrokeThickness="1" SnapsToDevicePixels="True" Cursor="SizeNESW" MouseLeftButtonDown="OnHandleDown" Tag="sw" />
                <Rectangle x:Name="HandleSe" Width="10" Height="10" Fill="White" Stroke="#1E88E5" StrokeThickness="1" SnapsToDevicePixels="True" Cursor="SizeNWSE" MouseLeftButtonDown="OnHandleDown" Tag="se" />
                <Rectangle x:Name="HandleN" Width="10" Height="10" Fill="White" Stroke="#1E88E5" StrokeThickness="1" SnapsToDevicePixels="True" Cursor="SizeNS" MouseLeftButtonDown="OnHandleDown" Tag="n" />
                <Rectangle x:Name="HandleS" Width="10" Height="10" Fill="White" Stroke="#1E88E5" StrokeThickness="1" SnapsToDevicePixels="True" Cursor="SizeNS" MouseLeftButtonDown="OnHandleDown" Tag="s" />
                <Rectangle x:Name="HandleW" Width="10" Height="10" Fill="White" Stroke="#1E88E5" StrokeThickness="1" SnapsToDevicePixels="True" Cursor="SizeWE" MouseLeftButtonDown="OnHandleDown" Tag="w" />
                <Rectangle x:Name="HandleE" Width="10" Height="10" Fill="White" Stroke="#1E88E5" StrokeThickness="1" SnapsToDevicePixels="True" Cursor="SizeWE" MouseLeftButtonDown="OnHandleDown" Tag="e" />
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
