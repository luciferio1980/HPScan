<Window x:Class="CanonScanStudio.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenido a Canon Scan Studio"
        Height="540" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <WrapPanel Margin="0,0,0,12">
                <Button Content="Descargar driver Canon" Style="{StaticResource SecondaryButton}" Click="OnDriver" Margin="0,0,8,8" />
                <Button Content="Elegir escáner de Windows" Style="{StaticResource SecondaryButton}" Click="OnPick" Margin="0,0,8,8" />
                <Button Content="Selector de red Canon" Style="{StaticResource SecondaryButton}" Click="OnSelector" Margin="0,0,8,8" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Buscar de nuevo" Style="{StaticResource SecondaryButton}" Click="OnSearch" Margin="0,0,8,0" />
                <Button Content="Continuar sin escáner" Style="{StaticResource SecondaryButton}" Click="OnSkip" Margin="0,0,8,0" />
                <Button Content="Seleccionar" Style="{StaticResource PrimaryButton}" Click="OnSelect" />
            </StackPanel>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Bienvenido a Canon Scan Studio" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusLabel" Text="Buscando escáneres..." Margin="0,12,0,12" Foreground="#6B6B6B" />
            <ListBox x:Name="DeviceList" Height="160" DisplayMemberPath="DisplayName" />
            <TextBlock Margin="0,12,0,0" Foreground="#6B6B6B" TextWrapping="Wrap"
                       Text="El PIXMA TS5151 suele aparecer como Canon TS5100 series. Si no sale nada, instala el MP Driver oficial (serie TS5100): no basta con que Windows imprima. En Wi-Fi abre el Selector de red Canon, marca el TS5100 y pulsa OK. Luego Buscar de nuevo o Elegir escáner de Windows." />
        </StackPanel>
    </DockPanel>
</Window>
