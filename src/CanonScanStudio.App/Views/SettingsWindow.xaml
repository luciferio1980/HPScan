<Window x:Class="CanonScanStudio.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Height="620" Width="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Exportar registro" Style="{StaticResource SecondaryButton}" Click="OnExportLog" Margin="0,0,8,0" />
            <Button Content="Cerrar" Style="{StaticResource PrimaryButton}" IsCancel="True" Click="OnClose" />
        </StackPanel>
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="Escáner" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Escáner predeterminado" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="DeviceBox" DisplayMemberPath="DisplayName" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Descargar driver Canon" Style="{StaticResource SecondaryButton}" Click="OnDriver" Margin="0,0,8,8" />
                    <Button Content="Selector de red Canon" Style="{StaticResource SecondaryButton}" Click="OnSelector" Margin="0,0,8,8" />
                    <Button Content="Impresoras y escáneres" Style="{StaticResource SecondaryButton}" Click="OnPrinters" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="Interfaz" Style="{StaticResource FieldLabel}" />
                <StackPanel>
                    <RadioButton x:Name="IfAuto" Content="Automático" GroupName="iface" />
                    <RadioButton x:Name="IfWia" Content="WIA" GroupName="iface" />
                    <RadioButton x:Name="IfTwain" Content="TWAIN" GroupName="iface" />
                </StackPanel>

                <Separator Style="{StaticResource Hairline}" />
                <TextBlock Text="Escaneo" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Resolución predeterminada" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="DpiBox" />
                <TextBlock Text="Color" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ColorBox" />
                <TextBlock Text="Tamaño" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="SizeBox" DisplayMemberPath="DisplayName" />

                <Separator Style="{StaticResource Hairline}" />
                <TextBlock Text="Guardado" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Carpeta predeterminada" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="..." Width="36" Click="OnBrowse" />
                    <TextBox x:Name="FolderBox" Margin="0,0,8,0" />
                </DockPanel>
                <TextBlock Text="Formato" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="FormatBox" />

                <Separator Style="{StaticResource Hairline}" />
                <TextBlock Text="Apariencia" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Tema" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ThemeBox" DisplayMemberPath="DisplayName" SelectionChanged="OnThemeChanged" />
                <TextBlock Text="Oscuro y Medianoche para de noche. Bosque, Atardecer, Océano y Lavanda cambian colores y acentos."
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />

                <Separator Style="{StaticResource Hairline}" />
                <TextBlock Text="Interfaz" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="RestoreBox" Content="Abrir automáticamente la última sesión" />
                <CheckBox x:Name="ConfirmBox" Content="Confirmar antes de eliminar páginas" Margin="0,6,0,0" />
                <CheckBox x:Name="DetailsBox" Content="Mostrar mensajes detallados de error" Margin="0,6,0,0" />

                <Separator Style="{StaticResource Hairline}" />
                <TextBlock Text="Diagnóstico" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Los registros se guardan en la carpeta de datos de usuario. Nunca se muestran códigos técnicos en la ventana principal." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
