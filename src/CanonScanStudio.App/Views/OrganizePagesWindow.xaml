<Window x:Class="CanonScanStudio.App.Views.OrganizePagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organizar páginas"
        Height="520" Width="720"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="#F7F7F7">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Arrastra una página o usa Subir / Bajar."
                       Foreground="#6B6B6B" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0" Click="OnCancel" />
                <Button Content="Aceptar" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnAccept" />
            </StackPanel>
        </DockPanel>
        <DockPanel DockPanel.Dock="Right" Margin="16,0,0,0">
            <StackPanel VerticalAlignment="Center">
                <Button Content="Subir" Style="{StaticResource SecondaryButton}" Click="OnMoveUp" Margin="0,0,0,8" />
                <Button Content="Bajar" Style="{StaticResource SecondaryButton}" Click="OnMoveDown" />
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="PageList"
                 Background="White"
                 BorderBrush="#D9D9D9"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="OnPreviewMouseDown"
                 MouseMove="OnMouseMove"
                 DragOver="OnDragOver"
                 Drop="OnDrop">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="8,6" Width="620">
                        <Border DockPanel.Dock="Left" Width="72" Height="92" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Margin="0,0,12,0">
                            <Image Source="{Binding Preview}" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
