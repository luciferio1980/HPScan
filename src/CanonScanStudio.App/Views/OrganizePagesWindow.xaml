<Window x:Class="CanonScanStudio.App.Views.OrganizePagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organizar páginas"
        Height="620" Width="980"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ShowInTaskbar="False"
        AllowDrop="True"
        PreviewMouseLeftButtonUp="OnPreviewMouseUp"
        DragOver="OnDragOver"
        Drop="OnDrop">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9D9D9" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Mover izquierda" Style="{StaticResource SecondaryButton}" MinWidth="120" Margin="0,0,8,0" Click="OnMoveLeft" />
                    <Button Content="Mover derecha" Style="{StaticResource SecondaryButton}" MinWidth="120" Margin="0,0,8,0" Click="OnMoveRight" />
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="110" Margin="0,0,8,0" Click="OnCancel" />
                    <Button Content="Aceptar" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="110" Click="OnAccept" />
                </StackPanel>
                <TextBlock Text="Arrastra cada imagen o usa Mover izquierda/derecha. Aceptar guarda el orden; Cancelar lo deja como estaba."
                           Foreground="#6B6B6B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
            </DockPanel>
        </Border>
        <ScrollViewer Padding="16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="PageList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="OnPreviewMouseDown"
                     PreviewMouseMove="OnPreviewMouseMove"
                     PreviewMouseLeftButtonUp="OnPreviewMouseUp"
                     DragOver="OnDragOver"
                     Drop="OnDrop"
                     GiveFeedback="OnGiveFeedback">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="8" />
                        <Setter Property="AllowDrop" Value="True" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="card" Background="White" BorderBrush="#D0D0D0" BorderThickness="2" CornerRadius="4" Padding="8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="#1E88E5" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="#90CAF9" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="160">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Image Source="{Binding Preview}" Stretch="Uniform" Height="200" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </DockPanel>
</Window>
