<Window x:Class="CanonScanStudio.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnóstico del escáner"
        Height="480" Width="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Realizar escaneo de prueba" Style="{StaticResource PrimaryButton}" Click="OnTestScan" Margin="0,0,8,0" />
            <Button Content="Cerrar" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnClose" />
        </StackPanel>
        <TextBox x:Name="ReportBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
    </DockPanel>
</Window>
