<Window x:Class="CanonScanStudio.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnóstico del escáner"
        Height="560" Width="620"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom">
            <WrapPanel Margin="0,12,0,8">
                <Button Content="Actualizar" Style="{StaticResource SecondaryButton}" Click="OnRefresh" Margin="0,0,8,8" />
                <Button Content="Elegir escáner de Windows" Style="{StaticResource SecondaryButton}" Click="OnPick" Margin="0,0,8,8" />
                <Button Content="Selector de red Canon" Style="{StaticResource SecondaryButton}" Click="OnSelector" Margin="0,0,8,8" />
                <Button Content="Descargar driver Canon" Style="{StaticResource SecondaryButton}" Click="OnDriver" Margin="0,0,8,8" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Realizar escaneo de prueba" Style="{StaticResource PrimaryButton}" Click="OnTestScan" Margin="0,0,8,0" />
                <Button Content="Cerrar" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </StackPanel>
        <TextBox x:Name="ReportBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
    </DockPanel>
</Window>
