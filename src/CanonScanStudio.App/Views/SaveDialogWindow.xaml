<Window x:Class="CanonScanStudio.App.Views.SaveDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardar"
        Height="320" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Guardar" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" />
            <TextBlock Text="Carpeta" Style="{StaticResource FieldLabel}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="..." Width="36" Click="OnBrowse" />
                <TextBox x:Name="FolderBox" Margin="0,0,8,0" />
            </DockPanel>
            <TextBlock Text="Tipo de archivo" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="FormatBox" />
            <CheckBox x:Name="SearchableBox" Content="PDF con texto seleccionable (OCR)" Margin="0,12,0,0" />
            <TextBlock x:Name="HintBox" Margin="0,8,0,0" Foreground="#6B6B6B" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
