<Window x:Class="CanonScanStudio.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayuda"
        Height="460" Width="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <Button DockPanel.Dock="Bottom" Content="Cerrar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsCancel="True" Click="OnClose" />
        <TextBox IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" FontSize="13"
                 Text="Canon Scan Studio controla el escáner a través de WIA, TWAIN y la API de escaneo de Windows. No utiliza una API privada de Canon.&#x0a;&#x0a;1. Enciende el PIXMA TS5151.&#x0a;2. Conéctalo por USB o instálalo en la misma red Wi-Fi con el MP Driver oficial (serie TS5100). Que Windows imprima no basta: tiene que aparecer un escáner.&#x0a;3. Pulsa F5 si el dispositivo no aparece. Puede mostrarse como Canon TS5100 series.&#x0a;4. Elige resolución y color, pulsa Escanear (F6).&#x0a;5. Edita, reordena y pulsa Guardar para crear un PDF. Pulsa Añadir página (o la tarjeta +) para escanear otra hoja. Girar izquierda/derecha rota la página seleccionada 90°.&#x0a;&#x0a;Atajos: Ctrl+N nueva sesión, Ctrl+S guardar, Ctrl+Z deshacer, Supr eliminar página.&#x0a;&#x0a;Esta aplicación no instala controladores de Canon. Si Windows no ve el escáner, instala el software oficial de la serie TS5100." />
    </DockPanel>
</Window>
