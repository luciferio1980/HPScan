<Window x:Class="CanonScanStudio.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayuda"
        Height="460" Width="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Descargar driver Canon" Style="{StaticResource SecondaryButton}" Click="OnDriver" Margin="0,0,8,0" />
            <Button Content="Cerrar" Style="{StaticResource PrimaryButton}" IsCancel="True" Click="OnClose" />
        </StackPanel>
        <TextBox IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" FontSize="13"
                 Text="Canon Scan Studio escanea el PIXMA TS5151 con WIA, TWAIN o Wi-Fi (eSCL). No usa una API privada de Canon.&#x0a;&#x0a;1. Enciende el PIXMA TS5151.&#x0a;2. USB, o la misma red Wi-Fi. En Wi-Fi: Configuración → Selector de red Canon, marca TS5100 series y pulsa Aceptar.&#x0a;3. Elige tamaño, resolución y color. La lista de DPI es la que anuncia el escáner: en Wi-Fi suele llegar a 600; 1200 aparece si USB/WIA lo admite.&#x0a;4. Pulsa Escanear. Añadir página, Eliminar y Girar actúan sobre el documento.&#x0a;5. Guardar crea el PDF.&#x0a;&#x0a;El nombre en Windows suele ser Canon TS5100 series, no TS5151. Esta aplicación no instala ni redistribuye controladores de Canon." />
    </DockPanel>
</Window>
