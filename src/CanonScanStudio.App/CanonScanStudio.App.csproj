<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>CanonScanStudio.App</RootNamespace>
    <AssemblyName>CanonScanStudio</AssemblyName>
    <Product>Canon Scan Studio</Product>
    <Description>Aplicación de escaneo para Windows orientada al Canon PIXMA TS5151.</Description>
    <ApplicationTitle>Canon Scan Studio</ApplicationTitle>
    <NeutralLanguage>es-ES</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CanonScanStudio.Core\CanonScanStudio.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>
</Project>
