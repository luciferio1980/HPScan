<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#E0B44A</Color>
    <Color x:Key="AccentDarkColor">#F0C96A</Color>
    <Color x:Key="SecondaryButtonColor">#3D5A80</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="WindowBg" Color="#0B1220" />
    <SolidColorBrush x:Key="PreviewAreaBg" Color="#070B14" />
    <SolidColorBrush x:Key="SettingsBg" Color="#122033" />
    <SolidColorBrush x:Key="HeaderBg" Color="#102033" />
    <SolidColorBrush x:Key="FooterBg" Color="#102033" />
    <SolidColorBrush x:Key="CardBg" Color="#1A2A40" />
    <SolidColorBrush x:Key="CardBorder" Color="#2E4666" />
    <SolidColorBrush x:Key="ControlBg" Color="#1A2A40" />
    <SolidColorBrush x:Key="ControlBorder" Color="#3D5A80" />
    <SolidColorBrush x:Key="BorderBrushSubtle" Color="#1C3048" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E8EEF7" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8FA3BF" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{StaticResource SecondaryButtonColor}" />
    <SolidColorBrush x:Key="SecondaryButtonHover" Color="#4F73A0" />
    <SolidColorBrush x:Key="BannerBg" Color="#3A2C10" />
    <SolidColorBrush x:Key="BannerForeground" Color="#F6D98A" />
    <SolidColorBrush x:Key="AddPageFill" Color="#122033" />
    <SolidColorBrush x:Key="AddPageHover" Color="#1E3A5C" />
    <SolidColorBrush x:Key="ReadyBrush" Color="#7DCEA0" />
    <SolidColorBrush x:Key="BusyBrush" Color="#F0C96A" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#E07A7A" />
</ResourceDictionary>
