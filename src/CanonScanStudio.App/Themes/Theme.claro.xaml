<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#1E88E5</Color>
    <Color x:Key="AccentDarkColor">#1565C0</Color>
    <Color x:Key="SecondaryButtonColor">#5A5A5A</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="WindowBg" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PreviewAreaBg" Color="#E8E8E8" />
    <SolidColorBrush x:Key="SettingsBg" Color="#F3EEE6" />
    <SolidColorBrush x:Key="HeaderBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FooterBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#D0D0D0" />
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorder" Color="#C8C8C8" />
    <SolidColorBrush x:Key="BorderBrushSubtle" Color="#D9D9D9" />
    <SolidColorBrush x:Key="TextPrimary" Color="#2B2B2B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B6B6B" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{StaticResource SecondaryButtonColor}" />
    <SolidColorBrush x:Key="SecondaryButtonHover" Color="#444444" />
    <SolidColorBrush x:Key="BannerBg" Color="#FFF8E1" />
    <SolidColorBrush x:Key="BannerForeground" Color="#5D4037" />
    <SolidColorBrush x:Key="AddPageFill" Color="#FAFAFA" />
    <SolidColorBrush x:Key="AddPageHover" Color="#E3F2FD" />
    <SolidColorBrush x:Key="ReadyBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="BusyBrush" Color="#EF6C00" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#C62828" />
</ResourceDictionary>
