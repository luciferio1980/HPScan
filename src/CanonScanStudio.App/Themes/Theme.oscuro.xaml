<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#64B5F6</Color>
    <Color x:Key="AccentDarkColor">#90CAF9</Color>
    <Color x:Key="SecondaryButtonColor">#5C5C60</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="WindowBg" Color="#1C1C1E" />
    <SolidColorBrush x:Key="PreviewAreaBg" Color="#121214" />
    <SolidColorBrush x:Key="SettingsBg" Color="#242426" />
    <SolidColorBrush x:Key="HeaderBg" Color="#2C2C2E" />
    <SolidColorBrush x:Key="FooterBg" Color="#2C2C2E" />
    <SolidColorBrush x:Key="CardBg" Color="#3A3A3C" />
    <SolidColorBrush x:Key="CardBorder" Color="#55555A" />
    <SolidColorBrush x:Key="ControlBg" Color="#3A3A3C" />
    <SolidColorBrush x:Key="ControlBorder" Color="#5C5C60" />
    <SolidColorBrush x:Key="BorderBrushSubtle" Color="#3F3F42" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F7" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A1A1A6" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{StaticResource SecondaryButtonColor}" />
    <SolidColorBrush x:Key="SecondaryButtonHover" Color="#7A7A80" />
    <SolidColorBrush x:Key="BannerBg" Color="#3E2F12" />
    <SolidColorBrush x:Key="BannerForeground" Color="#FFE082" />
    <SolidColorBrush x:Key="AddPageFill" Color="#2C2C2E" />
    <SolidColorBrush x:Key="AddPageHover" Color="#1E3A52" />
    <SolidColorBrush x:Key="ReadyBrush" Color="#81C784" />
    <SolidColorBrush x:Key="BusyBrush" Color="#FFB74D" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#EF9A9A" />
</ResourceDictionary>
