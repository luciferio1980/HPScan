<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#3D8B6E</Color>
    <Color x:Key="AccentDarkColor">#2F6F57</Color>
    <Color x:Key="SecondaryButtonColor">#4A6B58</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="WindowBg" Color="#E8F0EA" />
    <SolidColorBrush x:Key="PreviewAreaBg" Color="#D5E4D8" />
    <SolidColorBrush x:Key="SettingsBg" Color="#E4EDE4" />
    <SolidColorBrush x:Key="HeaderBg" Color="#F4F8F4" />
    <SolidColorBrush x:Key="FooterBg" Color="#F4F8F4" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#B7C9BB" />
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorder" Color="#B7C9BB" />
    <SolidColorBrush x:Key="BorderBrushSubtle" Color="#C5D4C8" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1E3328" />
    <SolidColorBrush x:Key="TextSecondary" Color="#4A6656" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{StaticResource SecondaryButtonColor}" />
    <SolidColorBrush x:Key="SecondaryButtonHover" Color="#385244" />
    <SolidColorBrush x:Key="BannerBg" Color="#E8F5E9" />
    <SolidColorBrush x:Key="BannerForeground" Color="#2E4A38" />
    <SolidColorBrush x:Key="AddPageFill" Color="#F4F8F4" />
    <SolidColorBrush x:Key="AddPageHover" Color="#D4E8DC" />
    <SolidColorBrush x:Key="ReadyBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="BusyBrush" Color="#EF6C00" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#C62828" />
</ResourceDictionary>
