<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#0D9488</Color>
    <Color x:Key="AccentDarkColor">#0F766E</Color>
    <Color x:Key="SecondaryButtonColor">#2A6F7F</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="WindowBg" Color="#E6F4F4" />
    <SolidColorBrush x:Key="PreviewAreaBg" Color="#CDE7E8" />
    <SolidColorBrush x:Key="SettingsBg" Color="#D9EEF0" />
    <SolidColorBrush x:Key="HeaderBg" Color="#F3FBFC" />
    <SolidColorBrush x:Key="FooterBg" Color="#F3FBFC" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#A9D0D3" />
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorder" Color="#A9D0D3" />
    <SolidColorBrush x:Key="BorderBrushSubtle" Color="#B9D8DB" />
    <SolidColorBrush x:Key="TextPrimary" Color="#13404A" />
    <SolidColorBrush x:Key="TextSecondary" Color="#4A7380" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{StaticResource SecondaryButtonColor}" />
    <SolidColorBrush x:Key="SecondaryButtonHover" Color="#1E5562" />
    <SolidColorBrush x:Key="BannerBg" Color="#E0F7FA" />
    <SolidColorBrush x:Key="BannerForeground" Color="#13404A" />
    <SolidColorBrush x:Key="AddPageFill" Color="#F3FBFC" />
    <SolidColorBrush x:Key="AddPageHover" Color="#C5E8E6" />
    <SolidColorBrush x:Key="ReadyBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="BusyBrush" Color="#EF6C00" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#C62828" />
</ResourceDictionary>
